# Copy this file to .env and fill in real values. Never commit .env — it's gitignored on purpose.
# DATABASE_URL needs a running PostgreSQL instance; REDIS_URL and MEILISEARCH_HOST are optional —
# the app falls back to in-memory rate limiting / plain SQL search when they're not set.

# --- Database (PostgreSQL)
DATABASE_URL="postgresql://youruser@localhost:5432/bias_collection"

# --- Auth
# Generate a fresh one, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse a value that's ever been committed or shared anywhere.
JWT_SECRET="replace-with-a-freshly-generated-64-char-hex-secret"
SESSION_TTL_DAYS="7"

# --- Rate limiting (Redis-backed when set; falls back to in-memory otherwise — see src/lib/api.ts)
REDIS_URL="redis://localhost:6379/0"

# --- Search (Meilisearch, self-hosted — falls back to SQL LIKE search when unset, see
# src/services/search.service.ts)
MEILISEARCH_HOST="http://127.0.0.1:7700"
MEILISEARCH_API_KEY="replace-with-your-meilisearch-master-key"

# --- Store
NEXT_PUBLIC_STORE_NAME="Awais Collection"
NEXT_PUBLIC_CURRENCY="Rs."

# --- File storage (local provider works out of the box; for Cloudinary fill these in and set STORAGE_PROVIDER=cloudinary)
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Payment gateways (sandbox placeholders — real keys go here, never in the DB)
CARD_GATEWAY_KEY=""
WALLET_GATEWAY_KEY=""

# --- Notification providers (leave blank to keep log-only behavior — see
# src/services/notification.service.ts)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""
